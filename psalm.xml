<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedCode="false"
    resolveFromConfigFile="true"
>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <!-- PSR-16 and json_decode return mixed; the is_array/is_string guards in
         MetadataFetcher are the narrowing, and the mixed assignment itself is
         not fixable in user code. Same issueHandler as yii3-settings. -->
    <issueHandlers>
        <MixedAssignment errorLevel="suppress"/>
    </issueHandlers>
</psalm>
